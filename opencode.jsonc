{
  "$schema": "https://opencode.ai/config.json",

  // 1) Auto-update
  "autoupdate": false,

  // 3) Default model (provider_id/model_id)
  "model": "moonshotai/kimi-k2",

  // 4) Default "thinking" = High (set model options globally)
  "provider": {
    "google": {
      "models": {
        "gemini-3-pro-preview": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    },
    "moonshotai": {
      "name": "Moonshot AI",
      "models": {
        "kimi-k2": {
          "name": "Kimi K2"
        }
      }
    }
  },

  // 5) Tasktracker MCP server (stdio bridge to the local server at 127.0.0.1:8787)
  "mcp": {
    "tasktracker": {
      "type": "local",
      "command": [
        "C:\\Users\\daric\\Downloads\\DTC\\Tasktracker\\installer\\build\\stage\\runtime\\node.exe",
        "C:\\Users\\daric\\Downloads\\DTC\\Tasktracker\\installer\\build\\stage\\app\\bin\\tasktracker-mcp"
      ],
      "enabled": true,
      "environment": {
        "TASKTRACKER_URL": "http://127.0.0.1:8787",
        "TASKTRACKER_TOKEN": "ttk_pM5IylUIpwz4qG0qgpIM6lXz"
      }
    }
  },

  // 6) Set all tools to allow (explicitly)
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "patch": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "question": "allow",

    // allow any MCP server tools too (wildcard)
    "*_*": "allow"
  }
}
